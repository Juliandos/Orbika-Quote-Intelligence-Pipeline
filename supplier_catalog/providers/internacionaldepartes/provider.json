{
    "provider_id":  "internacionaldepartes",
    "display_name":  "Internacional de Partes",
    "website":  "https://internacionaldepartes.com",
    "catalog_root_url":  "https://internacionaldepartes.com/productos",
    "access":  {
                   "type":  "open",
                   "requires_login":  false,
                   "read_only":  true
               },
    "selectors":  {
                      "catalog_root":  "https://internacionaldepartes.com/productos",
                      "count":  "#results-count",
                      "products":  "#product-grid",
                      "pagination":  "#pagination",
                      "product_links":  "#product-grid a[href*=\"/productos/\"]",
                      "filters":  "Present but not used by the live extractor"
                  },
    "data_precision":  {
                           "reference_codes":  true,
                           "vehicle_compatibility":  "visible",
                           "stock":  true,
                           "prices":  true,
                           "product_names":  true,
                           "detail_links":  true,
                           "image_urls":  true,
                           "descriptions":  "visible"
                       },
    "matching":  {
                     "allowed_match_types":  [
                                                 "vehicle_compatible",
                                                 "category_only",
                                                 "manual_confirmation_required"
                                             ],
                     "forbidden_match_types":  [
                                                   "exact_reference"
                                               ],
                     "notes":  "The live extractor follows the paginated product grid directly and does not rely on filters for the main catalog surface."
                 },
    "daily_refresh":  {
                          "enabled":  true,
                          "local_time":  "07:00",
                          "timezone":  "America/Bogota",
                          "snapshot_path_pattern":  "supplier_catalog/providers/internacionaldepartes/snapshots/YYYY-MM-DD/",
                          "outputs":  [
                                          "extracted.json",
                                          "products.csv",
                                          "diff.json",
                                          "summary.md",
                                          "listing_evidence.json",
                                          "detail_failures.json",
                                          "missing_products.json"
                                      ]
                      }
}
