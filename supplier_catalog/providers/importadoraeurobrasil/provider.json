{
  "provider_id": "importadoraeurobrasil",
  "display_name": "Importadora EuroBrasil",
  "website": "https://www.importadoraeurobrasil.com",
  "catalog_root_url": "https://www.importadoraeurobrasil.com/productos/",
  "access": {
    "type": "open",
    "requires_login": false,
    "read_only": true
  },
  "selectors": {
    "catalog_root": "https://www.importadoraeurobrasil.com/productos/",
    "result_count": "#main > div > p",
    "product_container": "#main > div > ul",
    "pagination": "#main > div > nav.woocommerce-pagination > ul",
    "product_link_pattern": "/producto/",
    "pagination_changes_url": true
  },
  "data_precision": {
    "reference_codes": true,
    "vehicle_compatibility": "partial",
    "stock": false,
    "prices": "partial",
    "product_names": true,
    "detail_links": true,
    "image_urls": true,
    "descriptions": "valid"
  },
  "matching": {
    "allowed_match_types": [
      "vehicle_compatible",
      "category_only",
      "manual_confirmation_required"
    ],
    "forbidden_match_types": [
      "exact_reference"
    ],
    "notes": "El extractor vivo recorre solamente /productos/, descubre dinamicamente toda la paginacion y consolida cada URL real del catalogo sin saltar a categorias externas."
  },
  "daily_refresh": {
    "enabled": true,
    "local_time": "07:00",
    "timezone": "America/Bogota",
    "snapshot_path_pattern": "supplier_catalog/providers/importadoraeurobrasil/snapshots/YYYY-MM-DD/",
    "outputs": [
      "extracted.json",
      "products.csv",
      "diff.json",
      "summary.md",
      "listing_evidence.json",
      "detail_failures.json"
    ]
  }
}
