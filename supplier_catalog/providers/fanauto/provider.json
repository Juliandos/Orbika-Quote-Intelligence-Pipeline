{
  "provider_id": "fanauto",
  "display_name": "Fanauto",
  "website": "https://fanauto.com.co/",
  "catalog_root_url": "https://fanauto.com.co/catalogo-digital/",
  "access": {
    "type": "open",
    "requires_login": false,
    "read_only": true
  },
  "selectors": {
    "flipbook_root": "https://fanauto.com.co/catalogo-digital/",
    "catalog_surface": "real3d flipbook / OCR image catalog"
  },
  "data_precision": {
    "reference_codes": true,
    "vehicle_compatibility": true,
    "stock": false,
    "prices": false,
    "product_names": true,
    "detail_links": false,
    "image_urls": true,
    "descriptions": "ocr_from_image_catalog"
  },
  "matching": {
    "allowed_match_types": [
      "manual_confirmation_required"
    ],
    "forbidden_match_types": [
      "exact_reference",
      "vehicle_compatible",
      "category_only"
    ],
    "notes": "Visual flipbook catalog processed page by page with OCR evidence. Use manual confirmation because layout is image-based and page titles may contain OCR noise."
  },
  "daily_refresh": {
    "enabled": true,
    "local_time": "07:00",
    "timezone": "America/Bogota",
    "snapshot_path_pattern": "supplier_catalog/providers/fanauto/snapshots/YYYY-MM-DD/",
    "outputs": [
      "extracted.json",
      "products.csv",
      "diff.json",
      "summary.md"
    ]
  }
}
