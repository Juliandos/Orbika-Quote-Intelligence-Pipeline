{
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build",
    "devPath": "http://127.0.0.1:3000",
    "distDir": "../../web/out"
  },
  "package": {
    "productName": "Orbika Console",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.orbika.console",
      "targets": [
        "msi",
        "nsis"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "windows": [
      {
        "title": "Orbika Console",
        "width": 1440,
        "height": 980,
        "resizable": true
      }
    ],
    "security": {
      "dangerousUseHttpScheme": true
    }
  }
}
